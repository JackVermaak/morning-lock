<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="icon_background">#F28C28</color>
    <color name="lock_background">#141A2E</color>

    <style name="AppTheme" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="LockTheme" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/lock_background</item>
        <item name="android:statusBarColor">@color/lock_background</item>
        <item name="android:navigationBarColor">@color/lock_background</item>
    </style>
</resources>
